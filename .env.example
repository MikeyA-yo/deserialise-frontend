# Browser-facing aggregator base URL. Production API, or http://localhost:3735.
VITE_AGGREGATOR_URL=http://localhost:3735

# Where the dev server proxies /agg (if used). Production API, or http://localhost:3735.
AGGREGATOR_PROXY_TARGET=http://localhost:3735

# Optional dedicated Base RPC. Defaults to a public fallback chain.
# VITE_BASE_RPC_URL=https://mainnet.base.org

# Optional WalletConnect Cloud project id. Enables the QR connector.
# VITE_WALLETCONNECT_PROJECT_ID=

# Optional integrator fee, forwarded to POST /base/swap as partnerFees.
# Recipient must be a checksummed or hex address. Fee is a percent (0.5 = 0.5%).
# VITE_PARTNER_FEE_RECIPIENT=
# VITE_PARTNER_FEE_PERCENT=
